{
  "id": "session-recording",
  "name": "Session Recording",
  "version": "1.2.0",
  "description": "Record terminal and remote desktop sessions and play them back or download them later.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Session-Recording",
  "docs": "https://docs.termix.site/plugins/session-recording",
  "video": "https://www.youtube.com/watch?v=fmYg3wqMHC0",
  "category": "Terminal",
  "icon": "ScrollText",
  "features": [
    "Record SSH, RDP and VNC sessions",
    "Play recordings back at any speed",
    "Download a recording as a file or plain text",
    "Old recordings are removed after a number of days you choose",
    "A dashboard card with your latest recordings"
  ],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.15"
  },
  "capabilities": [
    "hosts:read",
    "db:own",
    "files:own",
    "network:serve",
    "ui:surface",
    "events:core",
    "db:core-refs",
    "operations:provide"
  ],
  "provides": [
    {
      "service": "recordings.writer",
      "version": "1.1.0",
      "permission": "session-recording.view"
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "session-logs",
        "titleKey": "nav.sessionLogs",
        "icon": "ScrollText",
        "openFrom": ["rail"]
      }
    ],
    "permissions": [
      {
        "name": "view",
        "titleKey": "permissions.view.title",
        "descriptionKey": "permissions.view.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "retentionDays",
          "type": "number",
          "labelKey": "settings.admin.retentionDays.label",
          "descriptionKey": "settings.admin.retentionDays.description",
          "min": 1,
          "max": 3650,
          "default": 30
        }
      ],
      "host": {
        "editorGroup": "ssh",
        "editorOrder": 85,
        "enableKey": "enableSessionRecording",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "fields": []
      },
      "user": [
        {
          "key": "alwaysShowActions",
          "type": "boolean",
          "labelKey": "settings.alwaysShowActions.label",
          "descriptionKey": "settings.alwaysShowActions.description",
          "default": false
        }
      ]
    },
    "hostCapability": {
      "key": "enableSessionRecording",
      "labelKey": "hosts.enableSessionRecording",
      "editorTab": "general"
    },
    "dashboardCards": [
      {
        "id": "session-recordings",
        "titleKey": "card.title",
        "icon": "ScrollText"
      }
    ],
    "operations": {
      "actions": [
        {
          "id": "session-recording.list",
          "titleKey": "operations.list.title",
          "icon": "Film",
          "scope": "host",
          "risk": "read",
          "permission": "view",
          "hostAccess": "connect",
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "session-recording.usage",
          "titleKey": "operations.usage.title",
          "icon": "HardDrive",
          "scope": "host",
          "risk": "read",
          "permission": "view",
          "hostAccess": "connect",
          "surfaces": {
            "palette": false
          }
        }
      ],
      "resources": [
        {
          "id": "session-recording.recording",
          "titleKey": "operations.recording.title",
          "icon": "Film",
          "list": "session-recording.list",
          "key": "id",
          "name": "id",
          "tab": "session-logs",
          "columns": [
            {
              "key": "protocol",
              "titleKey": "operations.recording.protocol"
            },
            {
              "key": "started",
              "titleKey": "operations.recording.started"
            },
            {
              "key": "ended",
              "titleKey": "operations.recording.ended"
            }
          ]
        }
      ],
      "signals": [
        {
          "id": "session-recording.storage",
          "titleKey": "operations.storage.title",
          "read": "session-recording.usage",
          "scope": "host",
          "kind": "gauge",
          "refreshSec": 300
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
